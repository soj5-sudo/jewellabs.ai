# ---- AI provider ----
# "gemini" = real chat via Google AI Studio (needs GEMINI_API_KEY).
# If the key is missing the chatbot falls back to a built-in knowledge base.
AI_PROVIDER=gemini

# Get a key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Optional model overrides (defaults shown):
# GEMINI_TEXT_MODEL=gemini-flash-lite-latest
